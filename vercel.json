{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/core/:path*", "destination": "https://predictsim-core-service.onrender.com/:path*" },
    { "source": "/api/prediction/:path*", "destination": "https://predictsim-prediction-service.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
