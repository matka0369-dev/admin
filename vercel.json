{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/core/:path*", "destination": "https://CORE_SERVICE_URL/:path*" },
    { "source": "/api/prediction/:path*", "destination": "https://PREDICTION_SERVICE_URL/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
